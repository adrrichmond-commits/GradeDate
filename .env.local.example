# GradeDate local-only environment template — copy to `.env.local`.
# `.env.local` is gitignored; only local machine-specific tooling secrets
# belong here (e.g. Vercel CLI). NEVER commit this file or real values.

# Vercel CLI authentication for this sandbox (from the Vercel integration).
# Used only by the `vercel` CLI; the app itself never reads this value.
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here
