# GradeDate environment template — copy to `.env` and fill in real values.
# NEVER commit `.env` or any file containing real secret values.
# Local dev only needs VAPID_*; production (Vercel) injects the rest via
# Project Settings → Environment Variables.

# ── Local dev server (serve.ts / publish.sh) ────────────────────────────
# Web Push (required for the local server to start with push enabled).
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Public HTTPS origin used for canonical URLs, robots.txt, and sitemap.xml.
# Leave unset to fail closed; never set this to a proxy/internal hostname.
PUBLIC_SITE_ORIGIN=https://gradedate.app

# ── Database ─────────────────────────────────────────────────────────────
# Neon Postgres connection string (provided via the database integration).
DATABASE_URL=your_postgres_connection_string_here

# ── Photo storage ────────────────────────────────────────────────────────
# Vercel Blob read/write token. When unset, photos fall back to the local
# filesystem (`uploads/`), which is gitignored.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token_here
# Separate private Vercel Blob store token for quarantined photo objects (never reuse the public token).
PRIVATE_BLOB_READ_WRITE_TOKEN=your_private_blob_read_write_token_here
# Enable private review only when the private store and signing key are configured.
GRADEDATE_PRIVATE_REVIEW_STORAGE=false
GRADEDATE_REVIEW_SIGNING_KEY=

# ── AI grading ───────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Email (password reset, waitlist) ─────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── Stripe ───────────────────────────────────────────────────────────────
# Secret key (sk_live_...) and the webhook signing secret used to verify
# /api/stripe/webhook payloads.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe price IDs for upsells / Founders Club (optional; fall back to the
# hardcoded premium price when unset).
FOUNDERS_CLUB_PRICE_ID=your_founders_club_subscription_price_id_here
STRIPE_REGRADE_PRICE_ID=your_regrade_price_id_here
STRIPE_BOOST_PRICE_ID=your_boost_price_id_here
STRIPE_LIKE_PACK_PRICE_ID=your_like_pack_price_id_here

# ── Vercel CLI only (sandbox) ────────────────────────────────────────────
# Used by `vercel` CLI for deployment auth. Put this in `.env.local`, not
# `.env`. See .env.local.example.
# VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here

# Required in production for anonymous grade-CTA attribution claims (32+ random bytes)
ATTRIBUTION_CLAIM_SECRET=

# Vercel Cron authentication (required in Production; use a long random value).
# The daily retention endpoint fails closed when this is unset.
CRON_SECRET=

# ── Privileged WebAuthn passkey MFA (required in production) ─────────────
# Exact relying-party domain and browser origin; never use a preview/proxy URL.
WEBAUTHN_RP_ID=gradedate.app
WEBAUTHN_ORIGIN=https://gradedate.app
WEBAUTHN_RP_NAME=GradeDate
